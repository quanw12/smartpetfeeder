    "duration": "8", "extend": true, "overrideDelay": false, "units": "s", "reset": "", "bytopic": "all", "topic": "topic", "outputs": 1,
    "x": 590, "y": 220, "wires": [ [ "1d2f00000000f001" ] ]
  },
  {
    "id": "1d2f00000000e101", "type": "mqtt in", "z": "1d2f00000000a001", "name": "feeder/status", "topic": "feeder/status",
    "qos": "0", "datatype": "json", "broker": "1d2f00000000b001", "nl": false, "rap": true, "rh": 0, "inputs": 0,
    "x": 130, "y": 300, "wires": [ [ "1d2f00000000e102" ] ]
  },
  {
    "id": "1d2f00000000e102", "type": "function", "z": "1d2f00000000a001", "name": "Đọc xác nhận",
    "func": "// Chỉ xử lý sự kiện của ID 2; topic này có thể có sự kiện khác về sau.\nconst s = msg.payload;\nif (!s || s.event !== 'feed') return null;\n\nconst giay = (s.duration_ms / 1000).toFixed(1);\nlet text;\nlet ketThuc = false;   // true: ngừng đếm 8 s\nif (s.result === 'opening') {\n    text = `Đang mở cửa (${giay} s)`;\n} else if (s.result === 'done') {\n    text = `Đã cho ăn xong (${giay} s)`;\n    ketThuc = true;\n} else if (s.result === 'rejected' && s.reason === 'busy') {\n    // Lệnh trước vẫn đang chạy nên vẫn tiếp tục chờ done của lệnh đó.\n    text = 'Cửa đang mở, lệnh mới bị bỏ qua';\n} else if (s.result === 'rejected') {\n    text = 'Hộp từ chối lệnh không hợp lệ';\n    ketThuc = true;\n} else {\n    return null;\n}\nreturn [{ payload: text }, ketThuc ? { reset: true } : null];",
    "outputs": 2, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [],
    "x": 340, "y": 300, "wires": [ [ "1d2f00000000f001" ], [ "1d2f00000000e004" ] ]
  },
