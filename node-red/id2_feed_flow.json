  {
    "id": "1d2f00000000e002", "type": "function", "z": "1d2f00000000a001", "name": "Tạo lệnh cho ăn",
    "func": "// Đổi giây trên thanh trượt sang duration_ms, giữ trong khoảng firmware cho phép.\nconst giay = Number(flow.get('feedDurationS') ?? 1.5);\nconst durationMs = Math.round(Math.min(5, Math.max(0.2, giay)) * 1000);\n\n// retain=false: nếu retain, mỗi lần ESP32 kết nối lại sẽ tự cho ăn thêm.\nconst lenh = { topic: 'feeder/cmd/feed', payload: { duration_ms: durationMs }, qos: 0, retain: false };\nconst hienThi = { payload: 'Đã gửi lệnh, đang chờ hộp...' };\nreturn [lenh, hienThi];",
    "outputs": 2, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [],
    "x": 340, "y": 180, "wires": [ [ "1d2f00000000e003", "1d2f00000000e004" ], [ "1d2f00000000f001" ] ]
  },
