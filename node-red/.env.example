# Copy thành node-red/.env rồi điền. File .env không được đưa lên git.

# ID 3, 4, 6, 8: Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Dùng service_role / secret key. Key này chỉ nằm phía Node-RED, không xuất hiện trên trình duyệt.
SUPABASE_KEY=

# ID 5: tên topic ntfy. Ai biết tên là đọc được, nên đặt dài và khó đoán.
NTFY_TOPIC=smartpetfeeder-doi-ten-nay

# ID 8: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Nếu Gemini báo 429 thì đổi sang model có gói miễn phí trên trang pricing.
GEMINI_MODEL=gemini-3.8-flash

# ID 6: địa chỉ nhận email báo cáo 20:00. Tài khoản Gmail gửi + App Password điền trong node "Gmail SMTP".
EMAIL_TO=
